generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  sessions  Session[]
  createdAt DateTime  @default(now())
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  stance      String
  skillLevel  String
  boardType   String?
  goals       String?
  conditions  String?
  videoUrls   String[] // JSON array persisted as text via Prisma native type
  photoUrls   String[]
  thumbnail   String?
  analysisStatus String @default("processing")
  feedback    Json?
  createdAt   DateTime @default(now())
}
